{
  "name": "project-orion-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Project Orion - exposes project health data from SQL Server for Microsoft Copilot Studio",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js stdio",
    "start:http": "node dist/index.js http",
    "dev": "tsc && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "copilot",
    "sql-server",
    "project-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mssql": "^10.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
